generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RequestStatus {
  OPEN
  ACCEPTED
  SHIPPED
  DELIVERED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AttachmentKind {
  IMAGE
  AUDIO
  VIDEO
}

enum NotificationType {
  NEW_REQUEST
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  REQUEST_EXPIRED
  REQUEST_CLOSED
  REQUEST_SHIPPED
  REQUEST_DELIVERED
  SELLER_REGISTERED
  SELLER_APPROVED
  SELLER_REJECTED
  SYSTEM
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String
  googleId  String?  @unique
  avatar    String?
  role      UserRole @default(CUSTOMER)
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile?
  requests      PartRequest[]  @relation("CustomerRequests")
  notifications Notification[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model SellerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String
  description     String?
  logo            String?
  phone           String?
  city            String?
  address         String?
  status          SellerStatus @default(PENDING)
  rejectionReason String?
  adminNote       String?
  approvedAt      DateTime?
  rating          Float        @default(0)
  totalSales      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  categories     SellerCategory[]
  offers         Offer[]
  acceptedRequests PartRequest[] @relation("AcceptedSeller")

  @@index([status, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellers      SellerCategory[]
  requestItems RequestItem[]

  @@index([parentId, sortOrder])
}

model SellerCategory {
  id         String   @id @default(cuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([sellerId, categoryId])
  @@index([categoryId])
}

model PartRequest {
  id         String        @id @default(cuid())
  customerId String
  customer   User          @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(OPEN)
  expiresAt  DateTime
  city       String?
  address    String
  phone      String?
  plateNumber String?
  carMake    String?
  carModel   String?
  carYear    Int?
  notes      String?

  acceptedOfferId  String?       @unique
  acceptedOffer    Offer?        @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id])
  acceptedSellerId String?
  acceptedSeller   SellerProfile? @relation("AcceptedSeller", fields: [acceptedSellerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  items         RequestItem[]
  offers        Offer[]        @relation("RequestOffers")
  notifications Notification[]
  attachments   Attachment[]

  @@index([status, expiresAt])
  @@index([customerId, createdAt])
}

model RequestItem {
  id          String      @id @default(cuid())
  requestId   String
  request     PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  brand       String?
  partNumber  String?
  quantity    Int         @default(1)
  notes       String?
  createdAt   DateTime    @default(now())
  attachments Attachment[]

  @@index([requestId])
  @@index([categoryId])
}

model Offer {
  id                     String        @id @default(cuid())
  requestId              String
  request                PartRequest   @relation("RequestOffers", fields: [requestId], references: [id], onDelete: Cascade)
  sellerId               String
  seller                 SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  totalPrice             Int
  deliveryFee            Int           @default(0)
  estimatedDeliveryHours Int?
  note                   String?
  status                 OfferStatus   @default(PENDING)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  acceptedRequest PartRequest? @relation("AcceptedOffer")

  @@unique([requestId, sellerId])
  @@index([sellerId, status])
  @@index([requestId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  requestId String?
  request   PartRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model Attachment {
  id              String         @id @default(cuid())
  kind            AttachmentKind
  pathname        String         @unique
  url             String
  mimeType        String
  size            Int
  durationSeconds Int?
  requestId       String
  request         PartRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId          String?
  item            RequestItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([requestId])
  @@index([itemId])
}
